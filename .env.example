# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# --- Import par photo (vision) ---
# ATTENTION : ces clés sont des VARIABLES CONVEX (côté serveur), PAS des variables
# Vite. Ne les mettez jamais ici en VITE_* (elles seraient exposées au client).
# Configurez-les avec :  npx convex env set ANTHROPIC_API_KEY sk-ant-...
#   ANTHROPIC_API_KEY    (obligatoire pour l'import par photo)
#   ANTHROPIC_MODEL      (optionnel, défaut claude-sonnet-4-6)
#   ANTHROPIC_BASE_URL   (optionnel, défaut https://api.anthropic.com)

#   DEEPSEEK_API_KEY     (récap mensuel IA — DeepSeek, format compatible OpenAI)
#   DEEPSEEK_MODEL       (optionnel, défaut deepseek-chat)
#   DEEPSEEK_BASE_URL    (optionnel, défaut https://api.deepseek.com)
